<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WpfApp1"
        Title="GestiCoop - Offres de stage"
        Height="450" Width="800"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <local:OffreListeViewModel />
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Gestion des offres de stage"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,20" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- Liste des offres et boutons -->
            <Grid Grid.Column="0" Margin="0,0,15,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListView Grid.Row="0"
                          ItemsSource="{Binding Offres}"
                          SelectedItem="{Binding OffreSelectionnee, Mode=TwoWay}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Titre"
                                            Width="150"
                                            DisplayMemberBinding="{Binding Titre}" />
                            <GridViewColumn Header="Secteur"
                                            Width="100"
                                            DisplayMemberBinding="{Binding Secteur}" />
                            <GridViewColumn Header="Statut"
                                            Width="75"
                                            DisplayMemberBinding="{Binding Statut}" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Margin="0,10,0,0">
                    <Button Content="Ajouter"
                            Command="{Binding AjouterCommand}"
                            Width="90"
                            Margin="0,0,10,0" />
                    <Button Content="Supprimer"
                            Command="{Binding SupprimerCommand}"
                            Width="90" />
                </StackPanel>
            </Grid>

            <!-- Détails de l'offre sélectionnée -->
            <StackPanel Grid.Column="1"
                        DataContext="{Binding OffreSelectionnee}">

                <TextBlock Text="Détail de l'offre"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,15" />

                <TextBlock Text="Titre :" FontWeight="Bold" />
                <TextBox Text="{Binding Titre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,5,0,15" />

                <TextBlock Text="Secteur :" FontWeight="Bold" />
                <TextBox Text="{Binding Secteur, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,5,0,15" />

                <TextBlock Text="Statut :" FontWeight="Bold" />
                <TextBox Text="{Binding Statut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,5,0,15" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>